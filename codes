rules/local.rules

  
# ICMP Ping Detection
alert icmp any any -> any any (msg:"LAB ICMP ping detected"; itype:8; sid:1000001; rev:1# TCP SYN Scan Detection (requires validation)
alert tcp any any -> any any (msg:"LAB SYN scan"; flags:S; detection_filter:track by_src, count 20, seconds 5; sid:1000002; rev:1;)

# SSH Brute Force Detection (requires validation)
alert tcp any any -> any 22 (msg:"LAB SSH brute force"; flags:S; detection_filter:track by_src, count 5, seconds 60; sid:1000003; rev:1;)

# SQL Injection Detection (requires validation)
alert http any any -> any any (msg:"LAB SQLi UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; sid:1000004; rev:1;)

# Nikto User-Agent Detection (requires validation)
alert http any any -> any any (msg:"LAB Nikto UA"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; sid:1000005; rev:1;)
